# --- Core ---
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/prasaar
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Auth.js session secret: npx auth secret
AUTH_SECRET=
# Optional Google login
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Plan for new workspaces until billing ships (free | pro | beta)
DEFAULT_PLAN=beta

# --- Email (Resend). Unset in dev: emails print to the server console ---
RESEND_API_KEY=
EMAIL_FROM="Prasaar <noreply@example.in>"

# --- Queue (Upstash QStash). Unset in dev: an in-process sweep runs every 15s ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Vercel Cron sends this as a Bearer token
CRON_SECRET=

# --- Rate limits (Upstash Redis). Unset in dev: in-memory ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage: r2 (recommended), hostinger, or local (dev default: files go to ./.storage) ---
# Cloudflare R2: API token with Object Read & Write on the bucket. Public URL = the bucket's
# r2.dev address or a custom domain connected to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prasaar
R2_PUBLIC_BASE_URL=
# Hostinger upload service + CDN (alternative to R2)
STORAGE_DRIVER=
UPLOAD_SIGNING_SECRET=
UPLOAD_BASE_URL=
CDN_BASE_URL=

# --- Legal pages ---
# Registered company that operates Prasaar (defaults to "Prasaar")
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_COMPANY_ADDRESS=


# --- Platform apps (connect flows) ---
# Meta app (Facebook Pages + Instagram). Callback: {APP_URL}/api/connect/meta/callback
# Data deletion URL: {APP_URL}/api/meta/data-deletion · Deauthorize URL: {APP_URL}/api/meta/deauthorize
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration id (replaces the scope list)
META_LOGIN_CONFIG_ID=
# Optional: Graph API version (default v24.0)
META_GRAPH_VERSION=

# Instagram (Instagram API with Instagram Login), from the Meta app's Instagram product:
# "API setup with Instagram business login". Redirect URL: {APP_URL}/api/connect/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn app. Callback: {APP_URL}/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set to 1 once Community Management API access is approved (company pages)
LINKEDIN_ORG_SCOPES=
# Optional: LinkedIn-Version header, YYYYMM (default 202609)
LINKEDIN_API_VERSION=

# YouTube: Google Cloud OAuth client (Web application) with the YouTube Data API v3 enabled.
# Redirect URI: {APP_URL}/api/connect/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Telegram, Bluesky and Mastodon need no app keys: users supply a bot token or app
# password, and Mastodon apps are registered per server automatically.
